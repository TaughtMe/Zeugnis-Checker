{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Default permissions for the app",
    "windows": [
        "main"
    ],
    "permissions": [
        "core:default",
        "dialog:default",
        "fs:default",
        "fs:allow-write-text-file",
        "fs:allow-desktop-write",
        "fs:allow-document-write",
        "dialog:allow-save",
        {
            "identifier": "fs:allow-read",
            "allow": [
                {
                    "path": "$DOCUMENT/**"
                },
                {
                    "path": "$DOWNLOAD/**"
                }
            ]
        },
        {
            "identifier": "fs:allow-write",
            "allow": [
                {
                    "path": "$DESKTOP/**"
                },
                {
                    "path": "$DOCUMENT/**"
                }
            ]
        }
    ]
}